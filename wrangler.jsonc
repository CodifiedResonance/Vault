// Cloudflare: serve the built site in ./dist as static assets.
// Build command: python3 build.py    Deploy command: npx wrangler deploy
// "name" must match the project name in the Cloudflare dashboard.
{
  "name": "vault",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
